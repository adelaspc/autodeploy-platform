# Local credentials shared by ignored environment profiles.
# Copy this file to .env.secrets, fill only the values you need, and never commit it.
CONTROL_PLANE_MYSQL_PASSWORD=control_plane_password
CONTROL_PLANE_MYSQL_ROOT_PASSWORD=root_password
CONTROL_PLANE_REGISTRY_USERNAME=
CONTROL_PLANE_REGISTRY_PASSWORD=
CONTROL_PLANE_API_TOKEN_READ_ONLY=
CONTROL_PLANE_API_TOKEN_DEPLOYER=
CONTROL_PLANE_API_TOKEN_ADMIN=
CONTROL_PLANE_API_TOKENS_JSON=
CONTROL_PLANE_GITHUB_WEBHOOK_SECRET=
CONTROL_PLANE_METRICS_TOKEN=

# A project with git_secret_ref=GITHUB reads its token from this variable.
CONTROL_PLANE_GIT_TOKEN_GITHUB=
