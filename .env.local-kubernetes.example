# Local Kubernetes executor profile. Keep credentials in .env.secrets.
CONTROL_PLANE_ENV=development
CONTROL_PLANE_APP_PORT=5000
PORT=5000
CONTROL_PLANE_MYSQL_PORT=3306
CONTROL_PLANE_MYSQL_DATABASE=control_plane
CONTROL_PLANE_MYSQL_USER=control_plane_user
CONTROL_PLANE_EXECUTOR=kubernetes
CONTROL_PLANE_WORKSPACE_ROOT=/tmp/paas-workspaces
CONTROL_PLANE_LOCAL_REPO_ROOT=/tmp/paas-local-repos
CONTROL_PLANE_COMMAND_TIMEOUT_SECONDS=600
CONTROL_PLANE_COMMAND_RETRY_COUNT=1
CONTROL_PLANE_MAX_CONTENT_LENGTH=2097152
CONTROL_PLANE_TRUSTED_PROXY_COUNT=0
DOCKER_BUILDKIT=1
CONTROL_PLANE_COMPOSE_DOCKER_SOCKET_ENABLED=true
CONTROL_PLANE_REGISTRY_ENABLED=true
CONTROL_PLANE_REGISTRY_URL=docker.io
CONTROL_PLANE_REGISTRY_NAMESPACE=replace-with-your-registry-namespace
CONTROL_PLANE_ALLOW_AUTH_DISABLED=true
CONTROL_PLANE_KUBECONFIG=/tmp/paas-kubeconfig
CONTROL_PLANE_KUBECONFIG_HOST=/var/snap/microk8s/current/credentials/client.config
CONTROL_PLANE_KUBECONFIG_CONTAINER_SERVER=https://host.docker.internal:16443
CONTROL_PLANE_K8S_NAMESPACE=default
CONTROL_PLANE_K8S_IMAGE_PULL_SECRET=dockerhub-pull
CONTROL_PLANE_K8S_DEPLOYMENT_MODE=manifest
CONTROL_PLANE_K8S_HELM_CHART_PATH=deploy/helm/generic-web-app
CONTROL_PLANE_K8S_HELM_BINARY=helm
CONTROL_PLANE_K8S_HELM_TIMEOUT=180s
CONTROL_PLANE_K8S_INGRESS_ENABLED=true
CONTROL_PLANE_K8S_INGRESS_CLASS_NAME=
CONTROL_PLANE_K8S_INGRESS_BASE_DOMAIN=127.0.0.1.nip.io
CONTROL_PLANE_DEPLOY_HOST=127.0.0.1
CONTROL_PLANE_HEALTHCHECK_TIMEOUT_SECONDS=120
CONTROL_PLANE_K8S_ROLLOUT_TIMEOUT_SECONDS=120
CONTROL_PLANE_HEALTHCHECK_INTERVAL_SECONDS=1
CONTROL_PLANE_WORKER_POLL_INTERVAL_SECONDS=5
CONTROL_PLANE_RECONCILER_POLL_INTERVAL_SECONDS=60
CONTROL_PLANE_WORKER_ID=worker-1
CONTROL_PLANE_CLAIM_TTL_SECONDS=300
CONTROL_PLANE_CLAIM_REFRESH_INTERVAL_SECONDS=30
CONTROL_PLANE_METRICS_ENABLED=false
CONTROL_PLANE_LOG_FORMAT=json
